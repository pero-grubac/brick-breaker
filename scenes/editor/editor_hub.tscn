[node name="AuthorLabel" type="Label" parent="Margin/VBox/Columns/DetailPanel/Details"]
layout_mode = 2
theme_type_variation = &"BodyLabel"
text = "HUB_AUTHOR"

[node name="AuthorEdit" type="LineEdit" parent="Margin/VBox/Columns/DetailPanel/Details"]
unique_name_in_owner = true
layout_mode = 2
