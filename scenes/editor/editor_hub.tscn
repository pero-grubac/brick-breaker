size = Vector2i(560, 170)
ok_button_text = "DIALOG_YES"
cancel_button_text = "DIALOG_NO"
dialog_text = "HUB_DELETE_SET_TEXT"

[node name="ExportDialog" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "HUB_EXPORT_TITLE"
size = Vector2i(900, 560)
file_mode = 4
access = 2
filters = PackedStringArray("*.zip")
use_native_dialog = true

[node name="ImportDialog" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "HUB_IMPORT_TITLE"
size = Vector2i(900, 560)
ok_button_text = "HUB_IMPORT"
file_mode = 0
access = 2
filters = PackedStringArray("*.zip", "*.json")
